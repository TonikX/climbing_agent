# Copy to .env.public (ignored). Use a separate test bot/database/domain first.
POSTGRES_DB=climbing_journal
POSTGRES_PORT=25432
MIGRATION_DB_USER=climbing_migration
MIGRATION_DB_PASSWORD=CHANGE_ME
RUNTIME_DB_PASSWORD=CHANGE_ME_DIFFERENT
CONTROL_DB_PASSWORD=CHANGE_ME_DIFFERENT_AGAIN
INTERNAL_API_KEY=CHANGE_ME_RANDOM_32_OR_MORE_CHARACTERS
ACCESS_APPROVER_TELEGRAM_ID=
ACCESS_APPROVAL_CHAT_ID=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://test.example.com/telegram/webhook
CLOUDRU_API_KEY=
CLOUDRU_MODEL=deepseek-ai/DeepSeek-V4-Flash
CLOUDRU_ASR_MODEL=openai/whisper-large-v3
# Default: paid requests disabled; buttons and the manual form work.
# One budget unit = one kopeck. Reservation must upper-bound ONE provider call.
AI_DAILY_BUDGET_UNITS=0
AI_CALL_RESERVATION_UNITS=0
AI_DAILY_REQUESTS=20
AUDIO_DAILY_SECONDS=600
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
TLS_CERT_PATH=./deploy/tls/fullchain.pem
TLS_KEY_PATH=./deploy/tls/privkey.pem
# Review every ID first. Existing blocked users remain blocked.
PUBLIC_MIGRATION_MANIFEST='{"approved_user_ids":[],"location_owners":{}}'
