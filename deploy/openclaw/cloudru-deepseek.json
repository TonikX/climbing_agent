{
  "models": {
    "mode": "merge",
    "providers": {
      "cloudru": {
        "baseUrl": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "CLOUDRU_API_KEY"
        },
        "api": "openai-completions",
        "authHeader": true,
        "models": [
          {
            "id": "deepseek-ai/DeepSeek-V4-Flash",
            "name": "DeepSeek V4 Flash (Cloud.ru)",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 1048576
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "models": {
        "cloudru/deepseek-ai/DeepSeek-V4-Flash": {
          "alias": "DeepSeek V4 Flash"
        }
      },
      "modelPolicy": {
        "allow": [
          "openai/gpt-5.4-mini",
          "openai/gpt-5.4",
          "openrouter/auto",
          "cloudru/deepseek-ai/DeepSeek-V4-Flash"
        ]
      },
      "model": {
        "primary": "cloudru/deepseek-ai/DeepSeek-V4-Flash",
        "fallbacks": ["openrouter/auto"]
      },
      "heartbeat": {
        "model": "cloudru/deepseek-ai/DeepSeek-V4-Flash",
        "isolatedSession": true
      }
    }
  },
  "tools": {
    "media": {
      "models": [
        {
          "type": "provider",
          "provider": "openai",
          "model": "openai/whisper-large-v3",
          "profile": "openai:cloudru-audio",
          "baseUrl": "https://foundation-models.api.cloud.ru/v1",
          "capabilities": ["audio"]
        }
      ],
      "audio": {
        "enabled": true
      }
    }
  }
}
