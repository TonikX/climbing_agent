{
  "models": {
    "mode": "merge",
    "providers": {
      "openai": {
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "CLOUDRU_API_KEY"
        }
      },
      "cloudru": {
        "baseUrl": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "CLOUDRU_API_KEY"
        },
        "api": "openai-completions",
        "authHeader": true,
        "models": [
          {
            "id": "deepseek-ai/DeepSeek-V4-Flash",
            "name": "DeepSeek V4 Flash (Cloud.ru)",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 1048576
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "models": {
        "cloudru/deepseek-ai/DeepSeek-V4-Flash": {
          "alias": "DeepSeek V4 Flash"
        }
      },
      "modelPolicy": {
        "allow": [
          "openrouter/auto",
          "cloudru/deepseek-ai/DeepSeek-V4-Flash"
        ]
      },
      "model": {
        "primary": "cloudru/deepseek-ai/DeepSeek-V4-Flash",
        "fallbacks": ["openrouter/auto"]
      },
      "heartbeat": {
        "every": "0m",
        "model": "cloudru/deepseek-ai/DeepSeek-V4-Flash",
        "isolatedSession": true
      }
    }
  },
  "tools": {
    "alsoAllow": [
      "start_climbing_training",
      "append_climbing_attempt",
      "update_climbing_attempt",
      "delete_climbing_attempt",
      "finish_climbing_training",
      "get_current_climbing_training",
      "get_climbing_statistics",
      "save_climbing_training",
      "update_climbing_training",
      "upsert_climbing_gear",
      "find_climbing_routes",
      "get_climbing_trainings"
    ],
    "media": {
      "models": [
        {
          "type": "provider",
          "provider": "openai",
          "model": "openai/whisper-large-v3",
          "baseUrl": "https://foundation-models.api.cloud.ru/v1",
          "capabilities": ["audio"]
        }
      ],
      "audio": {
        "enabled": true
      }
    }
  },
  "channels": {
    "telegram": {
      "dmHistoryLimit": 2
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  }
}
