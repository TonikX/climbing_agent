# Copy to .env and set chmod 600. Never commit the real file.
APP_ENV=production
TZ=Europe/Moscow

# Generate independently, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-password
INTERNAL_API_KEY=replace-with-random-api-key
OPENCLAW_GATEWAY_TOKEN=replace-with-random-gateway-token

POSTGRES_DB=climbing_journal
POSTGRES_USER=climbing
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
NGINX_IMAGE=nginx:1.28-alpine
NGINX_HTTP_HOST=0.0.0.0
NGINX_HTTP_PORT=80
NGINX_HTTPS_HOST=0.0.0.0
NGINX_HTTPS_PORT=443

# Pin OpenClaw to the plugin build version. Upgrade deliberately.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.4
OPENCLAW_VERSION=2026.9.4
OPENCLAW_GATEWAY_PORT=18789

# Provider and Telegram secrets used by OpenClaw.
CLOUDRU_API_KEY=replace-me
OPENAI_API_KEY=replace-me
TELEGRAM_BOT_TOKEN=replace-me

# Persistent host directories. Absolute paths are recommended on the server.
OPENCLAW_CONFIG_HOST_DIR=/srv/climbing-journal/openclaw/config
OPENCLAW_WORKSPACE_HOST_DIR=/srv/climbing-journal/openclaw/workspace
OPENCLAW_AUTH_SECRET_HOST_DIR=/srv/climbing-journal/openclaw/auth-secrets
CERTBOT_WEBROOT_HOST_DIR=/srv/climbing-journal/certbot

# Obtain a trusted certificate before the first production start.
TLS_CERT_PATH=/etc/letsencrypt/live/api.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/api.example.com/privkey.pem
